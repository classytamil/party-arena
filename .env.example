# Copy this file to .env.local and fill in values from:
# Supabase Dashboard -> Project Settings -> API (Data API / API Keys)

# Public (sent to the browser) - used for Realtime Broadcast room-update pings
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR_ANON_KEY"

# Server-only secret header checked by the RLS policy on public.game_rooms
# (or optionally set SUPABASE_SERVICE_ROLE_KEY instead).
# NEVER prefix this with NEXT_PUBLIC_ and never commit .env.local.
PARTY_SERVER_KEY="YOUR_SERVER_ONLY_RLS_HEADER_SECRET"
